OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Set this to the deployed web origin for iOS and Android builds.
EXPO_PUBLIC_API_URL=https://your-vakya-app.vercel.app

# Leave empty for localhost or a root-domain deployment. GitHub Pages uses /VAKYA.
EXPO_PUBLIC_BASE_PATH=
